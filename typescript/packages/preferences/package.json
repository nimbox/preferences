{
  "name": "@nimbox/preferences",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "json2ts -i ../../../spec/property.schema.json -o ./src/generated/property.ts --cwd ../../../spec && json2ts -i ../../../spec/messages.schema.json -o ./src/generated/messages.ts --cwd ../../../spec && json2ts -i ../../../spec/values.schema.json -o ./src/generated/values.ts --cwd ../../../spec && json2ts -i ../../../spec/issue.schema.json -o ./src/generated/issue.ts --cwd ../../../spec",
    "build": "npm run generate && rm -rf dist && rollup -c && npm run build:types",
    "build:types": "tsc -p ./tsconfig.types.json",
    "build:watch": "rm -rf dist && rollup -cw",
    "typecheck": "npm run generate && tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "json-schema-to-typescript": "^15.0.4",
    "rollup": "^4.55.1",
    "rollup-plugin-filesize": "^10.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
